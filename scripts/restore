#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE THE APP MAIN DIR
#=================================================
ynh_script_progression "Restoring the app main directory..."

ynh_restore "$install_dir"

chown -R "$app:$app" "$install_dir"

#=================================================
# RESTORE SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Restoring system configurations related to $app..."

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"

ynh_restore "/etc/systemd/system/$app.service"
systemctl enable "$app.service" --quiet

yunohost service add "$app" --description="A WireGuard Dashboard" --log="/var/log/$app/$app.log"

ynh_restore "/etc/logrotate.d/$app"

#=================================================
# RESTORE VARIOUS FILES
#=================================================

ynh_restore "/var/log/$app/"

ynh_restore "/etc/wireguard/WGDashboard_Backup/"

ynh_restore "/etc/sysctl.d/$app.conf"
sysctl -p "/etc/sysctl.d/$app.conf"

#=================================================
# RESTORE WIREGUARD PERMISSIONS
#=================================================
ynh_script_progression "Restoring WireGuard permissions..."

# Ensure /etc/wireguard is properly owned by the app
# Ensure /etc/wireguard has proper permissions
if [ -d "/etc/wireguard" ]; then
    # Check if wireguard_ui is installed to determine permission strategy
    if yunohost app list | grep -q "id: wireguard" 2>/dev/null; then
        ynh_print_info "Detected wireguard_ui installation, using ACL for shared access..."
        
        # Use ACL to grant access without changing ownership
        setfacl -R -m u:$app:rwx /etc/wireguard
        setfacl -d -m u:$app:rwx /etc/wireguard
        
        if [ -d "/etc/amnezia" ]; then
            setfacl -R -m u:$app:rwx /etc/amnezia
            setfacl -d -m u:$app:rwx /etc/amnezia
        fi
    else
        ynh_print_info "No conflicting WireGuard app detected, taking ownership..."
        
        # Take full ownership
        chown -R "$app:$app" /etc/wireguard
        chmod 750 /etc/wireguard
        chmod -R o-rwx /etc/wireguard
        
        if [ -d "/etc/amnezia" ]; then
            chown -R "$app:$app" /etc/amnezia
            chmod 750 /etc/amnezia
            chmod -R o-rwx /etc/amnezia
        fi
    fi
fi

#=================================================
# RESTORE SUDOERS CONFIGURATION
#=================================================
ynh_script_progression "Restoring sudoers configuration for WireGuard management..."

# Restore sudoers configuration for WireGuard management
echo "$app ALL=(ALL) NOPASSWD: /usr/bin/wg, /usr/bin/wg-quick" > "/etc/sudoers.d/$app"

#=================================================
# RELOAD NGINX AND PHP-FPM OR THE APP SERVICE
#=================================================
ynh_script_progression "Reloading NGINX web server and $app's service..."

ynh_systemctl --service="$app" --action="start"

ynh_systemctl --service=nginx --action=reload

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restoration completed for $app"

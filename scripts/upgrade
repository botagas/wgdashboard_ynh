#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_setup_source --dest_dir="$install_dir" --full_replace

#=================================================
# SET UP PYTHON ENVIRONMENT
#=================================================
ynh_script_progression "Setting up Python virtual environment..."

ynh_script_progression "Setting up Python virtual environment..."

pushd "$install_dir"
    python3 -m venv venv
    venv/bin/pip install --upgrade pip
    venv/bin/pip install -r src/requirements.txt
popd

ynh_script_progression "Creating necessary directories for WGDashboard..."

mkdir -p "$install_dir/src/log"
mkdir -p "$install_dir/db" 
mkdir -p "$install_dir/download"

ynh_script_progression "Setting proper permissions..."

chmod +x "$install_dir/src/wgd.sh"

ynh_script_progression "Configuring WireGuard directory access for WGDashboard..."

# Ensure /etc/wireguard exists
if [ ! -d "/etc/wireguard" ]; then
    mkdir -p /etc/wireguard
fi

# Check if wireguard is installed to determine permission strategy
if yunohost app list | grep -q "id: wireguard" 2>/dev/null; then
    ynh_print_info "Detected wireguard installation, using ACL for shared access..."
    
    # Use ACL to grant access without changing ownership
    setfacl -R -m u:$app:rwx /etc/wireguard
    setfacl -d -m u:$app:rwx /etc/amnezia 2>/dev/null || true
    
    if [ -d "/etc/amnezia" ]; then
        setfacl -R -m u:$app:rwx /etc/amnezia
        setfacl -d -m u:$app:rwx /etc/amnezia
    fi
else
    ynh_print_info "No conflicting WireGuard app detected, taking ownership..."
    
    # Take full ownership
    chown -R "$app:$app" /etc/wireguard
    chmod 750 /etc/wireguard
    chmod -R o-rwx /etc/wireguard
    
    if [ -d "/etc/amnezia" ]; then
        chown -R "$app:$app" /etc/amnezia
        chmod 750 /etc/amnezia
        chmod -R o-rwx /etc/amnezia
    fi
fi

ynh_script_progression "Ensuring WGDashboard backup directory exists with proper permissions..."

mkdir -p /etc/wireguard/WGDashboard_Backup
chown "$app:$app" /etc/wireguard/WGDashboard_Backup
chmod 750 /etc/wireguard/WGDashboard_Backup

chown -R "$app:$app" "$install_dir"

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="A WireGuard Dashboard" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
